{
  "version": 2,
  "builds": [
    {
      "src": "restaurant-manage-backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "restaurant-manage-frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "restaurant-manage-backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "restaurant-manage-frontend/$1"
    }
  ]
}
